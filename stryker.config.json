{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["agent/**/*.ts", "!agent/**/*.test.ts", "!agent/app.ts"],
  "testRunner": "command",
  "commandRunner": {
    "command": "node --import ./scripts/test-environment.mjs --import tsx --test --test-concurrency=2 agent/*.test.ts agent/*/*.test.ts conformance/*.test.ts mock/*.test.ts scripts/*.test.mjs"
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 5000,
  "timeoutFactor": 1.5,
  "reporters": ["progress", "clear-text", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "clearTextReporter": {
    "reportMutants": false
  },
  "ignorePatterns": [
    "**/.env*",
    ".idea",
    "docs",
    "reports",
    "README.md",
    "SUBMISSION.md",
    "IMPLEMENTATION.md"
  ],
  "cleanTempDir": "always",
  "thresholds": {
    "high": 80,
    "low": 75,
    "break": 75
  }
}
